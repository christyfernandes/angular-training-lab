{
  "version": 1,
  "title": "Modern Angular for Professionals – learning path",
  "intro": "Work through the stages in order. Each step is a read, a video, something to explore in the running app, code to study, an exercise or a self-check. Tick steps as you finish them; your progress is saved in this browser.",
  "tracks": [
    {
      "id": "foundations",
      "name": "Foundations",
      "description": "New to Angular or to frontend frameworks: do every step in order (6 weeks)."
    },
    {
      "id": "accelerated",
      "name": "Accelerated",
      "description": "Already fluent in a component framework: skim weeks 1–2 and spend the time on the accelerated exercises (3–4 weeks)."
    }
  ],
  "concepts": [
    {
      "id": "typescript",
      "name": "TypeScript essentials"
    },
    {
      "id": "tooling",
      "name": "Tooling, CLI and conventions"
    },
    {
      "id": "components",
      "name": "Components, inputs, outputs, content projection"
    },
    {
      "id": "templates",
      "name": "Templates and bindings"
    },
    {
      "id": "control-flow",
      "name": "Built-in control flow (@if, @for, @switch, @let, @defer)"
    },
    {
      "id": "signals",
      "name": "Signals: signal, computed, effect, linkedSignal, resource"
    },
    {
      "id": "libraries",
      "name": "Component libraries"
    },
    {
      "id": "di",
      "name": "Dependency injection"
    },
    {
      "id": "state",
      "name": "Signal-based state stores"
    },
    {
      "id": "routing",
      "name": "Routing and lazy loading"
    },
    {
      "id": "http",
      "name": "HttpClient and httpResource"
    },
    {
      "id": "rxjs",
      "name": "RxJS essentials"
    },
    {
      "id": "interceptors",
      "name": "HTTP interceptors"
    },
    {
      "id": "guards",
      "name": "Guards and resolvers"
    },
    {
      "id": "forms",
      "name": "Forms: Signal Forms and Reactive Forms"
    },
    {
      "id": "pipes",
      "name": "Pipes"
    },
    {
      "id": "directives",
      "name": "Directives"
    },
    {
      "id": "i18n",
      "name": "Translations (i18n)"
    },
    {
      "id": "theming",
      "name": "Theming with Tailwind tokens"
    },
    {
      "id": "startup",
      "name": "Startup logic and runtime config"
    },
    {
      "id": "feature-flags",
      "name": "Feature flags"
    },
    {
      "id": "config-driven",
      "name": "Config-driven pages and forms"
    },
    {
      "id": "testing",
      "name": "Unit testing"
    },
    {
      "id": "performance",
      "name": "Performance"
    }
  ],
  "stages": [
    {
      "id": "week-1",
      "label": "Week 1",
      "title": "Foundations",
      "goal": "Read and write components, templates, bindings and built-in control flow in TypeScript.",
      "hours": 8,
      "steps": [
        {
          "id": "w1-setup",
          "kind": "setup",
          "title": "Set up your machine and run Karkhana",
          "files": [
            "START-HERE.md",
            "README.md"
          ],
          "lookFor": "Node 22.12+, Angular CLI 22, VS Code with the Angular Language Service, the app running on localhost:4200, all tests green.",
          "minutes": 60,
          "track": "both",
          "concepts": [
            "tooling"
          ]
        },
        {
          "id": "w1-ts",
          "kind": "read",
          "title": "TypeScript Handbook: everyday types, narrowing, classes, generics (skim what you know)",
          "url": "https://www.typescriptlang.org/docs/handbook/intro.html",
          "minutes": 120,
          "track": "foundations",
          "concepts": [
            "typescript"
          ]
        },
        {
          "id": "w1-learn",
          "kind": "read",
          "title": "Learn Angular in your browser: the components, templates and control flow lessons",
          "url": "https://angular.dev/tutorials/learn-angular",
          "minutes": 120,
          "track": "both",
          "concepts": [
            "components",
            "templates"
          ]
        },
        {
          "id": "w1-ess",
          "kind": "read",
          "title": "Angular Essentials: components, templates and control flow pages",
          "url": "https://angular.dev/essentials",
          "minutes": 40,
          "track": "both",
          "concepts": [
            "components",
            "templates"
          ]
        },
        {
          "id": "w1-watch",
          "kind": "watch",
          "title": "Angular – The Complete Guide (Udemy): getting started and essentials sections",
          "url": "https://www.udemy.com/course/the-complete-guide-to-angular-2/",
          "minutes": 150,
          "track": "foundations",
          "concepts": [
            "components",
            "templates"
          ],
          "note": "No course licence? Watch the matching topics on the official Angular YouTube channel instead."
        },
        {
          "id": "w1-lab",
          "kind": "explore",
          "title": "Concepts Lab: Bindings",
          "route": "/lab/bindings",
          "files": [
            "src/app/features/concepts-lab/bindings-demo.html",
            "src/app/features/concepts-lab/bindings-demo.ts"
          ],
          "lookFor": "Every binding type in panel 1; $index/$first/$even in @for; @switch; @let; content projection into ui-card.",
          "minutes": 45,
          "track": "both",
          "concepts": [
            "templates",
            "control-flow"
          ]
        },
        {
          "id": "w1-card",
          "kind": "study",
          "title": "The product card: a presentational component",
          "files": [
            "src/app/features/products/components/product-card.ts"
          ],
          "lookFor": "input.required(), output(), @let, chained pipes, NgOptimizedImage, no injected services.",
          "minutes": 40,
          "track": "both",
          "concepts": [
            "components",
            "pipes"
          ],
          "route": "/products"
        },
        {
          "id": "w1-ex-f",
          "kind": "exercise",
          "title": "Add a clear button to the search box that empties the search model and hides when the box is empty",
          "track": "foundations",
          "files": [
            "src/app/features/products/components/product-filters.ts"
          ],
          "minutes": 120,
          "concepts": [
            "templates",
            "components"
          ]
        },
        {
          "id": "w1-ex-a",
          "kind": "exercise",
          "title": "Move the home concept list into a typed concepts.ts file and add a text filter with computed()",
          "track": "accelerated",
          "files": [
            "src/app/features/home/home.ts",
            "src/app/features/home/home.html"
          ],
          "minutes": 120,
          "concepts": [
            "signals",
            "templates"
          ]
        },
        {
          "id": "w1-check",
          "kind": "check",
          "title": "Self-check: answer without looking",
          "questions": [
            "What is the difference between [value], [attr.aria-label] and [class.x]?",
            "Why does @for require track, and what makes a good track expression?",
            "When would you use @let instead of a component property?"
          ],
          "minutes": 15,
          "track": "both",
          "concepts": []
        }
      ]
    },
    {
