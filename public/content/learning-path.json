          "minutes": 60,
          "track": "both",
          "concepts": [
            "components"
          ]
        },
        {
          "id": "w2-libs",
          "kind": "read",
          "title": "Creating libraries",
          "url": "https://angular.dev/tools/libraries/creating-libraries",
